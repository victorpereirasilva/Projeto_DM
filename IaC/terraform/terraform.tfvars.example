# Modelo de variáveis do Projeto DM
# Copie para terraform.tfvars e substitua SEU_ACCOUNT_ID pelo ID real da sua conta AWS

name_bucket       = "projeto-dm-SEU_ACCOUNT_ID"
name_emr          = "projeto-dm-emr-SEU_ACCOUNT_ID"
versioning_bucket = "Enabled"
files_bucket      = "./pipeline"
files_data        = "./dados"
files_bash        = "./scripts"
alarm_email       = "seu-email@exemplo.com"
glue_db_name      = "projeto_dm_catalog"

# Dimensionamento do cluster EMR (escalabilidade vertical e horizontal)
emr_master_instance_type = "m5.xlarge"
emr_core_instance_type   = "m5.xlarge"
emr_core_instance_count  = 2
emr_max_capacity_units   = 10

# Segurança: origem autorizada a abrir SSH no EMR.
# Deixe vazio para não expor porta administrativa alguma (recomendado).
# Para acesso pontual, informe o SEU IP com máscara /32 — nunca 0.0.0.0/0.
allowed_ssh_cidr = ""
