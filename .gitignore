# Dados: o dataset é gerado por dados/gerar_dataset.py, não versionado
IaC/terraform/dados/*.csv
IaC/terraform/dados/processed/
IaC/terraform/dados/curated/

# Material de apoio (apresentação, runbook, plano de estudo) - uso local
docs/

# Credenciais
.env
*.pem
*.key
.aws/

# Logs e artefatos de execução
logs/
*.log

# Python
__pycache__/
*.py[cod]
.venv/
venv/

